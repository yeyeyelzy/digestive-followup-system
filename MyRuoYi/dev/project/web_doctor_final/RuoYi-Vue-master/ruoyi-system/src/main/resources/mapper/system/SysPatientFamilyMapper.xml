<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.SysPatientFamilyMapper">
    
    <resultMap type="SysPatientFamily" id="SysPatientFamilyResult">
        <result property="id"    column="id"    />
        <result property="familyId"    column="family_id"    />
        <result property="patientId"    column="patient_id"    />
        <result property="relationship"    column="relationship"    />
        <result property="status"    column="status"    />
        <result property="createTime"    column="create_time"    />
    </resultMap>

    <resultMap type="com.ruoyi.system.domain.Patient" id="PatientResult">
        <result property="patientId"    column="patient_id"    />
        <result property="patientName"    column="patient_name"    />
        <result property="phoneNumber"    column="phone_number"    />
        <result property="gender"    column="gender"    />
        <result property="age"    column="age"    />
        <result property="avatarUrl"    column="avatar_url"    />
    </resultMap>

    <sql id="selectSysPatientFamilyVo">
        select id, family_id, patient_id, relationship, status, create_time from sys_patient_family
    </sql>

    <select id="selectSysPatientFamilyList" parameterType="SysPatientFamily" resultMap="SysPatientFamilyResult">
        <include refid="selectSysPatientFamilyVo"/>
        <where>  
            <if test="familyId != null "> and family_id = #{familyId}</if>
            <if test="patientId != null "> and patient_id = #{patientId}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
    </select>
    
    <select id="selectSysPatientFamilyById" parameterType="Long" resultMap="SysPatientFamilyResult">
        <include refid="selectSysPatientFamilyVo"/>
        where id = #{id}
    </select>

    <select id="selectByFamilyAndPatient" resultMap="SysPatientFamilyResult">
        <include refid="selectSysPatientFamilyVo"/>
        where family_id = #{familyId} and patient_id = #{patientId}
    </select>

    <select id="selectBoundPatientsByFamilyId" parameterType="Long" resultMap="PatientResult">
        SELECT p.patient_id, p.patient_name, p.phone_number, p.gender, p.age, p.avatar_url 
        FROM patient p
        INNER JOIN sys_patient_family pf ON p.patient_id = pf.patient_id
        WHERE pf.family_id = #{familyId} 
        AND pf.status = '0'
    </select>
        
    <insert id="insertSysPatientFamily" parameterType="SysPatientFamily">
        insert into sys_patient_family
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="familyId != null">family_id,</if>
            <if test="patientId != null">patient_id,</if>
            <if test="relationship != null">relationship,</if>
            <if test="status != null">status,</if>
            <if test="createTime != null">create_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="familyId != null">#{familyId},</if>
            <if test="patientId != null">#{patientId},</if>
            <if test="relationship != null">#{relationship},</if>
            <if test="status != null">#{status},</if>
            <if test="createTime != null">#{createTime},</if>
         </trim>
    </insert>

    <update id="updateSysPatientFamily" parameterType="SysPatientFamily">
        update sys_patient_family
        <trim prefix="SET" suffixOverrides=",">
            <if test="familyId != null">family_id = #{familyId},</if>
            <if test="patientId != null">patient_id = #{patientId},</if>
            <if test="relationship != null">relationship = #{relationship},</if>
            <if test="status != null">status = #{status},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteSysPatientFamilyById" parameterType="Long">
        delete from sys_patient_family where id = #{id}
    </delete>

    <delete id="deleteSysPatientFamilyByIds" parameterType="String">
        delete from sys_patient_family where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>