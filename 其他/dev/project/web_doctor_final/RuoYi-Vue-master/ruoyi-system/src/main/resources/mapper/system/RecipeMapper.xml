<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.RecipeMapper">
    
    <resultMap type="Recipe" id="RecipeResult">
        <result property="recipeId"    column="recipe_id"    />
        <result property="recipeName"    column="recipe_name"    />
        <result property="authorId"    column="author_id"    />
        <result property="cover"    column="cover"    />
        <result property="quote"    column="quote"    />
        <result property="flavor"    column="flavor"    />
        <result property="rProcess"    column="r_process"    />
        <result property="duration"    column="duration"    />
        <result property="difficulty"    column="difficulty"    />
        <result property="tip"    column="tip"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
        <result property="status"    column="status"    />
        <result property="likedNum"    column="liked_num"    />
        <result property="collectedNum"    column="collected_num"    />
        <result property="remarkNum"    column="remark_num"    />
    </resultMap>

    <sql id="selectRecipeVo">
        select recipe_id, recipe_name, author_id, cover, quote, flavor, r_process, duration, difficulty, tip, create_time, update_time, status, liked_num, collected_num, remark_num from recipe
    </sql>

    <select id="selectRecipeList" parameterType="Recipe" resultMap="RecipeResult">
        <include refid="selectRecipeVo"/>
        <where>  
            <if test="recipeId != null "> and recipe_id = #{recipeId}</if>
            <if test="recipeName != null  and recipeName != ''"> and recipe_name like concat('%', #{recipeName}, '%')</if>
            <if test="authorId != null "> and author_id = #{authorId}</if>
            <if test="cover != null  and cover != ''"> and cover = #{cover}</if>
            <if test="quote != null  and quote != ''"> and quote = #{quote}</if>
            <if test="flavor != null  and flavor != ''"> and flavor = #{flavor}</if>
            <if test="rProcess != null  and rProcess != ''"> and r_process = #{rProcess}</if>
            <if test="duration != null  and duration != ''"> and duration = #{duration}</if>
            <if test="difficulty != null  and difficulty != ''"> and difficulty = #{difficulty}</if>
            <if test="tip != null  and tip != ''"> and tip = #{tip}</if>
            <if test="status != null "> and status = #{status}</if>
            <if test="likedNum != null "> and liked_num = #{likedNum}</if>
            <if test="collectedNum != null "> and collected_num = #{collectedNum}</if>
            <if test="remarkNum != null "> and remark_num = #{remarkNum}</if>
        </where>
    </select>
    
    <select id="selectRecipeByRecipeId" parameterType="Long" resultMap="RecipeResult">
        <include refid="selectRecipeVo"/>
        where recipe_id = #{recipeId}
    </select>
        
    <insert id="insertRecipe" parameterType="Recipe">
        insert into recipe
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="recipeId != null">recipe_id,</if>
            <if test="recipeName != null and recipeName != ''">recipe_name,</if>
            <if test="authorId != null">author_id,</if>
            <if test="cover != null">cover,</if>
            <if test="quote != null">quote,</if>
            <if test="flavor != null and flavor != ''">flavor,</if>
            <if test="rProcess != null and rProcess != ''">r_process,</if>
            <if test="duration != null and duration != ''">duration,</if>
            <if test="difficulty != null and difficulty != ''">difficulty,</if>
            <if test="tip != null">tip,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="status != null">status,</if>
            <if test="likedNum != null">liked_num,</if>
            <if test="collectedNum != null">collected_num,</if>
            <if test="remarkNum != null">remark_num,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="recipeId != null">#{recipeId},</if>
            <if test="recipeName != null and recipeName != ''">#{recipeName},</if>
            <if test="authorId != null">#{authorId},</if>
            <if test="cover != null">#{cover},</if>
            <if test="quote != null">#{quote},</if>
            <if test="flavor != null and flavor != ''">#{flavor},</if>
            <if test="rProcess != null and rProcess != ''">#{rProcess},</if>
            <if test="duration != null and duration != ''">#{duration},</if>
            <if test="difficulty != null and difficulty != ''">#{difficulty},</if>
            <if test="tip != null">#{tip},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="status != null">#{status},</if>
            <if test="likedNum != null">#{likedNum},</if>
            <if test="collectedNum != null">#{collectedNum},</if>
            <if test="remarkNum != null">#{remarkNum},</if>
         </trim>
    </insert>

    <update id="updateRecipe" parameterType="Recipe">
        update recipe
        <trim prefix="SET" suffixOverrides=",">
            <if test="recipeName != null and recipeName != ''">recipe_name = #{recipeName},</if>
            <if test="authorId != null">author_id = #{authorId},</if>
            <if test="cover != null">cover = #{cover},</if>
            <if test="quote != null">quote = #{quote},</if>
            <if test="flavor != null and flavor != ''">flavor = #{flavor},</if>
            <if test="rProcess != null and rProcess != ''">r_process = #{rProcess},</if>
            <if test="duration != null and duration != ''">duration = #{duration},</if>
            <if test="difficulty != null and difficulty != ''">difficulty = #{difficulty},</if>
            <if test="tip != null">tip = #{tip},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="status != null">status = #{status},</if>
            <if test="likedNum != null">liked_num = #{likedNum},</if>
            <if test="collectedNum != null">collected_num = #{collectedNum},</if>
            <if test="remarkNum != null">remark_num = #{remarkNum},</if>
        </trim>
        where recipe_id = #{recipeId}
    </update>

    <delete id="deleteRecipeByRecipeId" parameterType="Long">
        delete from recipe where recipe_id = #{recipeId}
    </delete>

    <delete id="deleteRecipeByRecipeIds" parameterType="String">
        delete from recipe where recipe_id in 
        <foreach item="recipeId" collection="array" open="(" separator="," close=")">
            #{recipeId}
        </foreach>
    </delete>
</mapper>