<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.DoctorsAdviceMapper">

    <resultMap type="DoctorsAdvice" id="DoctorsAdviceResult">
        <result property="doctorsAdviceId"    column="doctors_advice_id"    />
        <result property="patientId"    column="patient_id"    />
        <result property="patientName"    column="patient_name"    />
        <result property="medicationRegimen"    column="medication_regimen"    />
        <result property="reviewPlan"    column="review_plan"    />
        <result property="notice"    column="notice"    />
    </resultMap>

    <sql id="selectDoctorsAdviceVo">
        select doctors_advice_id, patient_id, patient_name, medication_regimen, review_plan, notice from doctors_advice
    </sql>

    <select id="selectDoctorsAdviceList" parameterType="DoctorsAdvice" resultMap="DoctorsAdviceResult">
        <include refid="selectDoctorsAdviceVo"/>
        <where>
            <if test="patientName != null  and patientName != ''"> and patient_name like concat('%', #{patientName}, '%')</if>
            <if test="medicationRegimen != null  and medicationRegimen != ''"> and medication_regimen = #{medicationRegimen}</if>
            <if test="reviewPlan != null  and reviewPlan != ''"> and review_plan = #{reviewPlan}</if>
            <if test="notice != null  and notice != ''"> and notice = #{notice}</if>
            <if test="patientId != null"> and patient_id = #{patientId}</if>

        </where>
    </select>

    <select id="selectDoctorsAdviceByDoctorsAdviceId" parameterType="Long" resultMap="DoctorsAdviceResult">
        <include refid="selectDoctorsAdviceVo"/>
        where doctors_advice_id = #{doctorsAdviceId}
    </select>

    <insert id="insertDoctorsAdvice" parameterType="DoctorsAdvice" useGeneratedKeys="true" keyProperty="doctorsAdviceId">
        insert into doctors_advice
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="patientId != null">patient_id,</if>
            <if test="patientName != null and patientName != ''">patient_name,</if>
            <if test="medicationRegimen != null and medicationRegimen != ''">medication_regimen,</if>
            <if test="reviewPlan != null and reviewPlan != ''">review_plan,</if>
            <!-- 【核心修正】移除 and notice != ''，允许插入空字符串 -->
            <if test="notice != null">notice,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="patientId != null">#{patientId},</if> <!-- 【核心修正】确保这里是 #{patientId} -->
            <if test="patientName != null and patientName != ''">#{patientName},</if>
            <if test="medicationRegimen != null and medicationRegimen != ''">#{medicationRegimen},</if>
            <if test="reviewPlan != null and reviewPlan != ''">#{reviewPlan},</if>
            <if test="notice != null">#{notice},</if>
        </trim>
    </insert>

    <update id="updateDoctorsAdvice" parameterType="DoctorsAdvice">
        update doctors_advice
        <trim prefix="SET" suffixOverrides=",">
            <if test="patientId != null">patient_id = #{patientId},</if>
            <if test="patientName != null and patientName != ''">patient_name = #{patientName},</if>
            <if test="medicationRegimen != null and medicationRegimen != ''">medication_regimen = #{medicationRegimen},</if>
            <if test="reviewPlan != null and reviewPlan != ''">review_plan = #{reviewPlan},</if>
            <if test="notice != null">notice = #{notice},</if>
        </trim>
        where doctors_advice_id = #{doctorsAdviceId}
    </update>

    <delete id="deleteDoctorsAdviceByDoctorsAdviceId" parameterType="Long">
        delete from doctors_advice where doctors_advice_id = #{doctorsAdviceId}
    </delete>

    <delete id="deleteDoctorsAdviceByDoctorsAdviceIds" parameterType="String">
        delete from doctors_advice where doctors_advice_id in
        <foreach item="doctorsAdviceId" collection="array" open="(" separator="," close=")">
            #{doctorsAdviceId}
        </foreach>
    </delete>
</mapper>
