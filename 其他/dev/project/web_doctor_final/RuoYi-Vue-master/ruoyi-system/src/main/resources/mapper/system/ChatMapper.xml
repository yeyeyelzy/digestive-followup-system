    <insert id="insertChat" parameterType="Chat" useGeneratedKeys="true" keyProperty="id">
        insert into chat
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="patientId != null">patient_id,</if>
            <if test="patientName != null">patient_name,</if>

            doctor_id, <!-- 【核心修复 1：移除 if 判断】 -->

            <if test="doctorName != null">doctor_name,</if>
            <if test="content != null">content,</if>
            <if test="direction != null">direction,</if>
            <!-- time 字段如果不是数据库自动填充，也应该在这里插入 -->
            <!-- <if test="time != null">time,</if> -->
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="patientId != null">#{patientId},</if>
            <if test="patientName != null">#{patientName},</if>

            #{doctorId}, <!-- 【核心修复 2：移除 if 判断】 -->

            <if test="doctorName != null">#{doctorName},</if>
            <if test="content != null">#{content},</if>
            <if test="direction != null">#{direction},</if>
            <!-- <if test="time != null">#{time},</if> -->
        </trim>
    </insert>

    <update id="updateChat" parameterType="Chat">
        update chat
        <trim prefix="SET" suffixOverrides=",">
            <if test="patientId != null">patient_id = #{patientId},</if>
            <if test="patientName != null">patient_name = #{patientName},</if>
            <if test="doctorId != null">doctor_id = #{doctorId},</if>
            <if test="doctorName != null">doctor_name = #{doctorName},</if>
            <if test="content != null">content = #{content},</if>
            <if test="time != null">time = #{time},</if>
            <if test="direction != null">direction = #{direction},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteChatById" parameterType="Long">
        delete from chat where id = #{id}
    </delete>

    <delete id="deleteChatByIds" parameterType="String">
        delete from chat where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>