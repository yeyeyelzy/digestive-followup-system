    <select id="selectChatList" parameterType="Chat" resultMap="ChatResult">
        <include refid="selectChatVo"/>
        <where>
            <!-- 【【【 核心修改：双向匹配逻辑 】】】 -->
            <!-- 只要是 patientId 和 doctorId 参与的对话，无论谁是 patient_id 谁是 doctor_id，都显示 -->
            <if test="patientId != null and doctorId != null">
                AND (
                (patient_id = #{patientId} AND doctor_id = #{doctorId})
                OR
                (patient_id = #{doctorId} AND doctor_id = #{patientId})
                )
            </if>

            <!-- 如果没有 patientId 或 doctorId，则继续使用原有的单个过滤条件，但通常不应该出现 -->
            <if test="patientId != null and doctorId == null"> and patient_id = #{patientId}</if>
            <if test="doctorId != null and patientId == null"> and doctor_id = #{doctorId}</if>

            <!-- ... 移除其他的 like 查询，防止干扰，如果需要可以重新添加 ... -->
            <!-- 移除下面这些不需要的模糊查询：
            <if test="patientName != null  and patientName != ''"> and patient_name like concat('%', #{patientName}, '%')</if>
            <if test="doctorName != null  and doctorName != ''"> and doctor_name like concat('%', #{doctorName}, '%')</if>
            <if test="content != null  and content != ''"> and content = #{content}</if>
            -->
            <if test="time != null "> and time = #{time}</if>
            <if test="direction != null "> and direction = #{direction}</if>
        </where>
        ORDER BY time ASC
    </select>
    
    <select id="selectChatById" parameterType="Long" resultMap="ChatResult">
        <include refid="selectChatVo"/>
        where id = #{id}
        ORDER BY time
    </select>
        
