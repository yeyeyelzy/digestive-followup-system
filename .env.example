# Local reference template only. Applications read process environment variables;
# production values must come from CI/CD, containers, or a secret manager.
# Legacy variable aliases remain supported for one release cycle; use DFS_* for new setup.

# Shared environment
DFS_APP_ENV=dev

# Backend HTTP and storage
DFS_BACKEND_HOST=127.0.0.1
DFS_BACKEND_PORT=8080
DFS_STORAGE_PUBLIC_BASE_URL=http://127.0.0.1:8080
DFS_STORAGE_UPLOAD_DIR=./var/files/
DFS_STORAGE_PROFILE_DIR=./var/uploadPath
DFS_SWAGGER_ENABLED=true

# Database, Redis and authentication
DFS_DB_MASTER_URL=jdbc:mysql://127.0.0.1:3306/suifang?useUnicode=true&characterEncoding=utf8&zeroDateTimeBehavior=convertToNull&useSSL=false&serverTimezone=Asia/Shanghai
DFS_DB_MASTER_USERNAME=change_me
DFS_DB_MASTER_PASSWORD=change_me
DFS_DB_SLAVE_ENABLED=false
DFS_REDIS_HOST=127.0.0.1
DFS_REDIS_PORT=6379
DFS_REDIS_DATABASE=0
DFS_REDIS_PASSWORD=
DFS_AUTH_JWT_SECRET=replace-with-a-long-random-secret
DFS_AUTH_TOKEN_EXPIRE_MINUTES=30
DFS_DRUID_MONITOR_ALLOW=127.0.0.1
DFS_DRUID_MONITOR_USERNAME=change_me
DFS_DRUID_MONITOR_PASSWORD=change_me

# AI service
DFS_AI_BASE_URL=http://127.0.0.1:8010
DFS_AI_REPORT_ROOT=./var/ai-reports
DFS_AI_TIMEOUT_MS=30000
DFS_AI_REHAB_TIMEOUT_MS=60000
DFS_AI_REHAB_VIEW_TIMEOUT_MS=8000
DFS_AI_REPORT_TIMEOUT_MS=90000
DFS_AI_CACHE_TTL_MS=300000

# Python data and knowledge base. Use absolute paths in staging/prod.
# DFS_PROJECT_ROOT=D:/path/to/digestive-followup-system
# DFS_FITABASE_DATA_DIR=D:/secure-data/fitabase
# DFS_APP_DATA_DIR=D:/secure-data/input
# DFS_APP_OUTPUT_DIR=D:/secure-output/reports
# DFS_PATIENT_CONFIG_PATH=D:/secure-data/patients.local.json
# DFS_KB_BASE_DIR=D:/secure-data/knowledge-base
# DFS_CHROMA_DB_DIR=D:/secure-output/chroma-db
DFS_EMBEDDING_MODEL=shibing624/text2vec-base-chinese
DFS_EMBEDDING_DEVICE=cpu
DFS_EMBEDDING_BATCH_SIZE=32
DFS_EMBEDDING_MAX_LENGTH=512
DFS_CHROMA_COLLECTION_NAME=medical_guidelines_v2
